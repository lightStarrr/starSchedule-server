# 复制为 .env 后使用。标注「必改」的值不改会直接启动失败或存在安全风险。
# 生成随机密钥：openssl rand -base64 48（JWT）、openssl rand -base64 32（加密密钥）

# ===== 镜像（必改）=====
# 由 GitHub Actions 构建并推送到 GHCR，改成你的 GitHub 用户名/组织（全小写）
# 可用 tag：latest（main 最新）、main、sha-xxxxxxx、v1.2.3
APP_IMAGE=ghcr.io/your-name/starschedule-server:latest

# ===== 运行环境 =====
APP_ENV=production
# 容器内固定监听 8080，对外端口由 HTTP_PORT 决定
HTTP_ADDR=:8080
HTTP_PORT=8080
# 统计数据按此时区切日，查询不做时区转换
APP_TZ=Asia/Shanghai
LOG_LEVEL=info

# ===== PostgreSQL =====
# 必改：数据库密码。compose 会用下面三项自动拼出 DATABASE_URL
POSTGRES_USER=starschedule
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=starschedule
# 仅「不用 compose、直接跑二进制」时生效；compose 会忽略这一行
DATABASE_URL=postgres://starschedule:change-me-postgres@localhost:5432/starschedule?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ===== Redis =====
# 必改：Redis 密码
REDIS_PASSWORD=change-me-redis
# 仅「不用 compose、直接跑二进制」时生效；compose 内固定为 redis:6379
REDIS_ADDR=localhost:6379
REDIS_DB=0

# ===== 鉴权（必改）=====
# 两套独立密钥，均至少 32 字符
DEVICE_JWT_SECRET=change-me-device-secret-at-least-32-chars-long
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-chars-long
# 设备 token 有效期 30 天，剩余不足 7 天时通过响应头滑动续期
DEVICE_TOKEN_TTL=720h
DEVICE_TOKEN_REFRESH_AFTER=552h
# 后台会话 7 天
ADMIN_TOKEN_TTL=168h
# 必改：ANDROID_ID 加盐盐值，泄露后哈希可被彩虹表反推
DEVICE_FINGERPRINT_PEPPER=change-me-pepper

# ===== 上游 API Key 加密（必改）=====
# AES-256-GCM，必须是 base64 编码的 32 字节：openssl rand -base64 32
# 部署后不要再改，否则后台已保存的供应商密钥将无法解密
APP_ENCRYPTION_KEY=Y2hhbmdlLW1lLWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=

# ===== 初始管理员（必改）=====
# 只在首次启动且 admin_users 为空时创建，之后改这里不会覆盖已有密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ===== 其它 =====
# 开发态 Vite 调试源，多个用逗号分隔；生产留空
CORS_ORIGINS=
METRICS_ENABLED=true
# 反代已终止 TLS 时保持 false；本地直接 http 调试可设 true
ALLOW_INSECURE_COOKIE=false
