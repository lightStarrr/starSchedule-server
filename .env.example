# ===== 运行环境 =====
APP_ENV=production
HTTP_ADDR=:8080
# 统计数据按此时区切日，查询不做时区转换
APP_TZ=Asia/Shanghai
LOG_LEVEL=info
# 对外暴露端口（docker compose 用）
HTTP_PORT=8080

# ===== 数据库（compose 内使用 postgres 服务名） =====
POSTGRES_USER=starschedule
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=starschedule
DATABASE_URL=postgres://starschedule:change-me-postgres@postgres:5432/starschedule?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ===== Redis =====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# ===== 鉴权 =====
# 至少 32 字符，生成：openssl rand -base64 48
DEVICE_JWT_SECRET=change-me-device-secret-at-least-32-chars-long
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-chars-long
DEVICE_TOKEN_TTL=720h
DEVICE_TOKEN_REFRESH_AFTER=552h
ADMIN_TOKEN_TTL=168h
# ANDROID_ID 加盐盐值，泄露会导致哈希可被彩虹表反推
DEVICE_FINGERPRINT_PEPPER=change-me-pepper

# ===== 上游 API Key 加密（AES-256-GCM，base64 的 32 字节）=====
# 生成：openssl rand -base64 32
APP_ENCRYPTION_KEY=Y2hhbmdlLW1lLWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=

# ===== 初始管理员（仅首次启动创建，之后不会覆盖密码）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ===== 其它 =====
# 开发态 Vite 调试源，多个用逗号分隔；生产留空
CORS_ORIGINS=
METRICS_ENABLED=true
# 仅本地 http 调试时设为 true（否则 Cookie 带 Secure，浏览器不接受 http）
ALLOW_INSECURE_COOKIE=false
